#!/bin/bash
#SBATCH -A che260063p
#SBATCH -p GPU-small
#SBATCH -t 2:00:00
#SBATCH -N 1
#SBATCH --gpus=v100-32:1
#SBATCH --job-name=resume_test_2
#SBATCH --output=/ocean/projects/che260063p/shared/logs/slurm-%j.out
#SBATCH --mail-type=ALL,TIME_LIMIT_80
#SBATCH --mail-user=anshulk@andrew.cmu.edu
# made by make_sbatch.py from the Bridges-2 guide; estimated at most 2 SU
# -p changed by hand to GPU-small, as in resume_test_1.job; job 1 there showed the same AllocTRES as a GPU-shared V100 task (billing=5).
# files created here are owned by the Unix group in effect at submission (p. 7):
# submit after 'newgrp che260063p' or run 'chgrp -R che260063p /ocean/projects/che260063p/shared/logs' afterwards
umask 002                      # files stay group-writable for the project team (guide B9)
export PYTHONNOUSERSITE=1      # packages in ~/.local must not leak into conda or pip environments (guide C27)
set -x
cd /ocean/projects/che260063p/shared/logs
bash /ocean/projects/che260063p/shared/runs/resume_test/code/slurm/resume_test.sh dense A2 A3 B C E2:small EB:small; RC=$?
cd /ocean/projects/che260063p/shared/runs/resume_test/code && /ocean/projects/che260063p/shared/envs/mlip/bin/python -u -B scripts/resume_compare.py /ocean/projects/che260063p/shared/runs/resume_test --refs A1 A2 A3 --tests B C --steps 400 --out /ocean/projects/che260063p/shared/runs/resume_test/results/dense; RC=$((RC | $?))
/ocean/projects/che260063p/shared/envs/mlip/bin/python -u -B scripts/resume_compare.py /ocean/projects/che260063p/shared/runs/resume_test --refs E1 E2 --tests EB --steps 400 --epoch-check --out /ocean/projects/che260063p/shared/runs/resume_test/results/epoch; RC=$((RC | $?))
exit $RC
