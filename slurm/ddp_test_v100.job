#!/bin/bash
#SBATCH -A che260063p
#SBATCH -p GPU-small
#SBATCH -t 3:00:00
#SBATCH -N 1
#SBATCH --gpus=v100-32:2
#SBATCH --job-name=ddp_test_v100
#SBATCH --output=/ocean/projects/che260063p/shared/ddp_test/logs/slurm-%j.out
#SBATCH --mail-type=ALL,TIME_LIMIT_80
#SBATCH --mail-user=anshulk@andrew.cmu.edu
# made by make_sbatch.py from the Bridges-2 guide; estimated at most 6 SU
# Runs the copy that `b2.py syncrepo <this repository> /ocean/projects/che260063p/shared/ddp_repo_parent` makes; that copy and
# shared/ddp_test were deleted after the runs of 2026-11-03 (docs/ddp.md), so make the copy again before a rerun.
# -p changed by hand to GPU-small (one V100-32 node, 1 SU per V100-hour as in resume_test_1.job): on 2026-11-03 14:41 sbatch
# --test-only gave 2 GPUs on GPU-small a start within an hour and on GPU-shared (any type) about 32 h later.
# files created here are owned by the Unix group in effect at submission (p. 7):
# submit after 'newgrp che260063p' or run 'chgrp -R che260063p /ocean/projects/che260063p/shared/ddp_test' afterwards
umask 002                      # files stay group-writable for the project team (guide B9)
export PYTHONNOUSERSITE=1      # packages in ~/.local must not leak into conda or pip environments (guide C27)
set -x
cd /ocean/projects/che260063p/shared/ddp_test
bash /ocean/projects/che260063p/shared/ddp_repo_parent/AI4Science-MLIPs/slurm/ddp_test.sh v100
