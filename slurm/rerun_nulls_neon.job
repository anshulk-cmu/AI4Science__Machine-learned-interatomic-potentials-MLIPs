#!/bin/bash
#SBATCH -A che260063p
#SBATCH -p GPU-shared
#SBATCH -t 2:00:00
#SBATCH -N 1
#SBATCH --gpus=v100-32:1
#SBATCH --job-name=rerun_chk
#SBATCH --output=/ocean/projects/che260063p/shared/logs/slurm-%j.out
