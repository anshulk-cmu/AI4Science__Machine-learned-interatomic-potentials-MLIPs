#!/bin/bash
#SBATCH -A che260063p
#SBATCH -p GPU-small
#SBATCH -t 1:00:00
#SBATCH -N 1
#SBATCH --gpus=v100-32:1
#SBATCH --job-name=time_checkpoint_eval
#SBATCH --output=/ocean/projects/che260063p/shared/logs/slurm-%j.out
#SBATCH --mail-type=ALL,TIME_LIMIT_80
#SBATCH --mail-user=anshulk@andrew.cmu.edu
# made by make_sbatch.py from the Bridges-2 guide; estimated at most 1 SU
# -p changed by hand from GPU-shared to GPU-small (one V100-32 node, not in the guide's tables): on 2026-11-03 at 01:20
# sbatch --test-only gave GPU-small a start at 01:55 and GPU-shared a start a day later.
# Times the checkpoint tools' evaluator (scripts/time_checkpoint_eval.py) on 300 rows of split_test_10.txt with the
# final checkpoints of the Dense and Local-6 pilots (seed 0), float32 and float64. The accuracy values are not results:
# the pilots trained on pilot_train_200k.txt, which holds 20,240 rows of the test set.
# files created here are owned by the Unix group in effect at submission (p. 7):
# submit after 'newgrp che260063p' or run 'chgrp -R che260063p /ocean/projects/che260063p/shared/repo_split/AI4Science-MLIPs' afterwards
umask 002                      # files stay group-writable for the project team (guide B9)
export PYTHONNOUSERSITE=1      # packages in ~/.local must not leak into conda or pip environments (guide C27)
set -x
cd /ocean/projects/che260063p/shared/repo_split/AI4Science-MLIPs
export FAIRCHEM_CACHE_DIR=/ocean/projects/che260063p/shared/cache/fairchem WARP_CACHE_PATH=/ocean/projects/che260063p/shared/cache/warp; OUT=/ocean/projects/che260063p/shared/runs/time_eval_$SLURM_JOB_ID; mkdir -p $OUT; nvidia-smi --query-gpu=name,memory.total --format=csv
for v in dense_s0_49041937 local6_s0_49041936; do /ocean/projects/che260063p/shared/envs/mlip/bin/python -u -B scripts/time_checkpoint_eval.py --checkpoint $(ls /ocean/projects/che260063p/shared/runs/pilot_$v/train/*/checkpoints/final/inference_ckpt.pt) --data /ocean/projects/che260063p/shared/data/omol25/train_4M --rows manifests/split_test_10.txt --n 300 --device cuda --out $OUT/timing_$v.json || exit 1; done
