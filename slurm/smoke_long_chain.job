#!/bin/bash
#SBATCH -A che260063p
#SBATCH -p GPU-shared
#SBATCH -t 1:00:00
#SBATCH -N 1
#SBATCH --gpus=v100-32:1
#SBATCH --job-name=smoke_long_chain
#SBATCH --output=/ocean/projects/che260063p/shared/logs/slurm-%j.out
#SBATCH --mail-type=ALL,TIME_LIMIT_80
#SBATCH --mail-user=anshulk@andrew.cmu.edu
# made by make_sbatch.py from the Bridges-2 guide; estimated at most 1 SU
# files created here are owned by the Unix group in effect at submission (p. 7):
# submit after 'newgrp che260063p' or run 'chgrp -R che260063p /ocean/projects/che260063p/shared/logs' afterwards
umask 002                      # files stay group-writable for the project team (guide B9)
export PYTHONNOUSERSITE=1      # packages in ~/.local must not leak into conda or pip environments (guide C27)
set -x
cd /ocean/projects/che260063p/shared/logs
# Test only (docs/launch-checklist.md): one Dense long run of 180 steps as three segments of slurm/long_run.sh in one job.
# Segment A stops the way a time limit stops it: SIGALRM makes timeout act as if its time ran out (TERM to the training process,
# exit 124), once step 60 is saved. Segment B resumes and finishes. Segment C finds DONE and exits at once. Then the readers.
R=/ocean/projects/che260063p/shared
J=$SLURM_JOB_ID
export LONG_REPO=$R/repo_integration/AI4Science-MLIPs LONG_RUNS_DIR=$R/runs/smoke_integration_$J
export LONG_STEPS=180 LONG_SEED=0 LONG_EVAL_EVERY=180 LONG_CKPT_EVERY=20 LONG_SEGMENT_HOURS=1
RUN=$LONG_RUNS_DIR/long_dense_s0_180
( until [ -e "$RUN/train/long_dense_s0_180/checkpoints/step_60/.metadata" ]; do sleep 2; done; sleep 5
  pkill -ALRM -u "$(id -un)" -f "^timeout --foreground .* OMOL_RUN_DIR=$RUN/train " ) &
SLURM_JOB_ID=${J}a bash "$LONG_REPO/slurm/long_run.sh" dense; echo "segment A exit $?"
SLURM_JOB_ID=${J}b bash "$LONG_REPO/slurm/long_run.sh" dense; echo "segment B exit $?"
SLURM_JOB_ID=${J}c bash "$LONG_REPO/slurm/long_run.sh" dense; echo "segment C exit $?"
cd "$LONG_REPO"
"$R/envs/mlip/bin/python" -B scripts/collect_final_metrics.py "$RUN" --steps 180 --expected-seeds 1 --variants dense --output "$RUN/metrics_auto.csv"; echo "collect auto exit $?"
"$R/envs/mlip/bin/python" -B scripts/collect_final_metrics.py "$RUN" --steps 180 --expected-seeds 1 --variants dense --source log --output "$RUN/metrics_log.csv"; echo "collect log exit $?"
cat "$RUN"/metrics_*.csv
"$R/envs/mlip/bin/python" -B -c "import sys; from training.checkpoints import discover; print('discover', [s for s, _ in discover(sys.argv[1], 180)])" "$RUN"
cat "$RUN/settings.txt" "$RUN/summary.txt" "$RUN/segments.txt"
[ -f "$RUN/DONE" ]
