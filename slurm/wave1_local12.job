#!/bin/bash
#SBATCH -A che260063p
#SBATCH -p GPU-shared
#SBATCH -t 48:00:00
#SBATCH -N 1
#SBATCH --gpus=h100-80:1
#SBATCH --job-name=wave1_local12
#SBATCH --array=0-4
#SBATCH --output=/ocean/projects/che260063p/shared/logs/slurm-%A_%a.out
#SBATCH --error=/ocean/projects/che260063p/shared/logs/slurm-%A_%a.err
#SBATCH --mail-type=ALL,TIME_LIMIT_80
#SBATCH --mail-user=anshulk@andrew.cmu.edu
# made by make_sbatch.py from the Bridges-2 guide; estimated at most 96 SU
# Wave 1 (docs/launch-checklist.md): seeds 0 to 4 = the array task ids; folders runs/final_<variant>_s<seed>_<jobid>.
# The estimate is per task: at most 480 SU for the 5 tasks at the 48 h cap; only the hours used are charged.
# files created here are owned by the Unix group in effect at submission (p. 7):
# submit after 'newgrp che260063p' or run 'chgrp -R che260063p /ocean/projects/che260063p/shared/logs' afterwards
umask 002                      # files stay group-writable for the project team (guide B9)
export PYTHONNOUSERSITE=1      # packages in ~/.local must not leak into conda or pip environments (guide C27)
set -x
cd /ocean/projects/che260063p/shared/logs
export PILOT_RUN_PREFIX=final
export PILOT_STEPS=${PILOT_STEPS:-50000}
bash "${PILOT_REPO:-/ocean/projects/che260063p/shared/repo/AI4Science-MLIPs}/slurm/pilot.sh" local12
