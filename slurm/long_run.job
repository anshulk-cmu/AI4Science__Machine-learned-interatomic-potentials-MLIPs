#!/bin/bash
#SBATCH -A bapoczos
#SBATCH -p preempt
#SBATCH --qos=preempt_qos
#SBATCH -t 12:00:00
#SBATCH -N 1
#SBATCH --gres=gpu:1
#SBATCH --constraint=VRAM_48GB|VRAM_80GB|VRAM_96GB|VRAM_141GB
#SBATCH --cpus-per-gpu=4
#SBATCH --mem-per-gpu=32G
#SBATCH --requeue
#SBATCH --signal=B:USR1@90
#SBATCH --open-mode=append
#SBATCH --job-name=long_run
#SBATCH --output=/data/user_data/anshulk/mlip/logs/slurm-%x-%j.out
#SBATCH --mail-type=ALL,TIME_LIMIT_80
#SBATCH --mail-user=anshulk@andrew.cmu.edu
# One segment of a long run on CMU Babel (babel/mlipOnBabel.md of the course workspace, Section 3.3). Submit it only through
# slurm/submit_chain.sh, which sets --gres, --constraint, -t, --job-name, --output, the afterany dependency and every LONG_*
# setting (--export). Without them long_run.sh stops at once (exit 2). The --output folder must exist (Slurm does not make it).
# Preemptible: Slurm requeues the job with the same id; long_run.sh treats USR1 and TERM as a stop, never as a failure.
umask 002
export PYTHONNOUSERSITE=1      # packages in ~/.local must not leak into the environment
set -x
cd "${LONG_SHARED:?}/logs" || exit 1
# exec: --signal=B:USR1 reaches only the batch shell, so long_run.sh must be that shell to see it
exec bash "${LONG_REPO:?}/slurm/long_run.sh" "${LONG_VARIANT:-}"
